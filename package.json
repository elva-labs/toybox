{
  "name": "elva-cli-toybox",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "arcade": "dist/arcade.js"
  },
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/arcade.js --banner:js='#!/usr/bin/env node' && chmod +x dist/arcade.js",
    "start": "npm run build && node dist/arcade.js",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "description": "A small toolbox of games for the terminal"
}
